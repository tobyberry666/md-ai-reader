{
  "name": "dsh-md-reader",
  "version": "0.1.9",
  "description": "md-ai-reader · 读到哪里，问到哪里。DSH Markdown 阅读与全文 AI 问答插件",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobyberry666/md-ai-reader.git"
  },
  "homepage": "https://github.com/tobyberry666/md-ai-reader#readme",
  "keywords": ["deepseek-harness", "markdown", "reader", "ai", "dsh-plugin"],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/contracts.md",
    "docs/assets/hero.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
